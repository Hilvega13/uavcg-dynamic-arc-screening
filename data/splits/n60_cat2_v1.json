  },
  "split_rule": {
    "statement": "Within each family, sort by the measured single-call probe time ascending, then deal the instances alternately into the two buckets with the TEST bucket picking first (ranks 0,2,4... -> test; 1,3... -> train).",
    "why": "Bucket sizes then come out exactly as the approved matrix requires (C2 train2/test3, RC2 train2/test2, R2 train1/test2), and dealing alternately makes both buckets span the difficulty range instead of giving one bucket all the cheap instances.",
    "side_effect_documented": "All three step-5 landing representatives (C201/RC201/R201) fall in the test bucket. That is a consequence of the rule, not a hand-placed exception: each is the cheapest instance of its family, so it is rank 0.",
    "probe_source": "results/_probe_matrix.jsonl",
    "tw_scale_source": "the loosest factor at which one full-network pricing call landed under the 20s envelope (spec §3.3); the floor is x0.35"
  },
  "families": {
    "C2": {"train": 2, "test": 3, "n_candidates_probed": 5, "solomon_family_size": 8},
